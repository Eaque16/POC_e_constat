# Faster-Whisper local inference
MODEL_NAME=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_BEAM_SIZE=3
# Limite la generation par segment et evite de depasser les 448 positions Whisper.
WHISPER_MAX_NEW_TOKENS=128
# Facultatif : laisser vide utilise les lexiques versionnes comme hotwords.
# Si WHISPER_INITIAL_PROMPT est renseigne, les hotwords sont desactives pour
# ne pas depasser la limite de contexte du decodeur Whisper.
WHISPER_HOTWORDS=
WHISPER_INITIAL_PROMPT=

# Maximum uploaded audio size in bytes (25 MiB)
MAX_AUDIO_SIZE=26214400

# FastAPI address used by the Gradio frontend
BACKEND_URL=http://127.0.0.1:8000

# Local structured extraction
# deterministic = reponse immediate ; Ollama reste activable depuis l'interface.
EXTRACTION_MODE=deterministic
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b
OLLAMA_TIMEOUT=120
OLLAMA_MAX_TOKENS=256
OLLAMA_CONTEXT_LENGTH=2048
