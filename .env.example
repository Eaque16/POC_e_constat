APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+psycopg://econstat:econstat@localhost:5432/econstat
JWT_SECRET=change-me-with-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480
HF_TOKEN=
WHISPER_MODEL=bofenghuang/whisper-large-v3-french
WHISPER_REVISION=e0e885752469ae13df3c68b2bc35b3fbe6293ae6
WHISPER_DISTIL_MODEL=bofenghuang/whisper-large-v3-french-distil-dec16
WHISPER_DISTIL_REVISION=16bd02185bdaa6b00fb4b0deb46e47ac1b754b8e
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
# Renseigner le SHA obtenu après accès gated (le setup refuse "main" en mode IA strict).
DIARIZATION_REVISION=main
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL_CPU=qwen3:4b
OLLAMA_MODEL_8GB=qwen3:8b
OLLAMA_MODEL_16GB=qwen3:14b
OLLAMA_MODEL_20GB=qwen3.6:27b
VRAM_THRESHOLD_8B_GB=8
VRAM_THRESHOLD_14B_GB=16
VRAM_THRESHOLD_27B_GB=20
LLM_TEMPERATURE=0.0
ENABLE_LLM=true
DISABLE_AUTH=false
RANDOM_SEED=42
ECONSTA_BASE_URL=http://localhost:8001
ECONSTA_API_KEY=demo-local-key
UPLOAD_DIR=./data/uploads
PDF_DIR=./generated
LEXICON_PATH=./data/lexique_ci.json
ALLOW_MODEL_DOWNLOADS=false
