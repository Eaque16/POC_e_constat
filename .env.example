APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
DATABASE_URL=sqlite:///./econstat-local.db

# Obligatoire hors tests locaux. Générer une valeur robuste, ne jamais la committer.
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480
DISABLE_AUTH=false

UPLOAD_DIR=./data/uploads
RECORDINGS_DIR=./data/recordings
GENERATED_DIR=./generated
MODEL_DIR=./models
LEXICON_PATH=./data/lexique_ci.json
MAX_AUDIO_MB=100
MAX_AUDIO_DURATION_SECONDS=7200
ALLOWED_AUDIO_EXTENSIONS=.wav,.mp3,.m4a,.ogg,.flac

ALLOW_MODEL_DOWNLOADS=false
PROCESSING_PROFILE=fast
JOB_STALE_MINUTES=30
JOB_POLL_SECONDS=2
JOB_MAX_RETRIES=3

WHISPER_FAST_MODEL=./models/whisper-tiny
WHISPER_QUALITY_MODEL=./models/whisper-ct2
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=fr
WHISPER_FAST_BEAM_SIZE=1
WHISPER_QUALITY_BEAM_SIZE=5

# Requis uniquement pour pyannote après acceptation manuelle de la licence.
HF_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-community-1
DIARIZATION_NUM_SPEAKERS=2

OLLAMA_ENABLED=true
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_MODEL_CPU=qwen3:4b
LLM_TEMPERATURE=0
LLM_SEED=42

ECONSTA_BASE_URL=http://127.0.0.1:8001
ECONSTA_API_KEY=
